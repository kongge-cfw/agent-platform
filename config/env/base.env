# 打进镜像的公共非密默认；密钥不要写在这里。
# 启动时已存在的环境变量（宿主机 --env-file / -e）优先，不会被本文件覆盖。
TZ=Asia/Shanghai
PLATFORM_TIMEZONE=Asia/Shanghai
API_SERVICE_PORT=8001
# 公网二级目录前缀。空=挂在站点根路径。
# 与其它系统共用一个 IP:端口时必须设为 /zhiyuan（MCP issuer / 调度深链 / OpenAPI 都读这个值）。
# Nginx 仍应设置 X-Forwarded-Prefix，但不能只靠 Header。
APP_ROOT_PATH=
API_SERVICE_LOG_LEVEL=INFO
TASK_SCHEDULER_ENABLED=true
REDIS_ENABLE=true
REDIS_PORT=6379
MYSQL_PORT=3306
POSTGRES_PORT=5432
API_SERVICE_API_KEY_HASH_ALGORITHM=sha256

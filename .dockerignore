# Git
.git
.gitignore

# IDE
.vscode
.idea
.gemini
.agent

# Python bytecode / 仓库根虚拟环境（不要用裸 venv/、*.so，会误伤 vendor/venv 里的扩展）
__pycache__
*.py[cod]
*$py.class
.Python
/env/
/venv/
/ENV/
/.venv
/.venv/

# Testing
.pytest_cache
.coverage
htmlcov/
.tox/

# Environment
.env
.env.*
!env.example

# Frontend source (exclude node_modules; dist / vendor 需保留，由主机编译后 COPY 进镜像)
frontend/node_modules
# vendor/ 不要忽略：compile-python.sh 的 venv / ms-playwright 必须进构建上下文

# Runtime-generated and user-owned data (never send these into the Docker build context)
data/agent_workspaces/
data/uploads/
data/browser-profiles/
data/branding/
data/generated/
data/generated_files/
data/office_preview_cache/
data/sandbox/

# Docs and metadata (safe to ignore)
architech/
openspec/
AGENTS.md

# Logs
*.log
logs/

# Docker image export artifacts (kept on the host, never copied into images)
docker/release/
